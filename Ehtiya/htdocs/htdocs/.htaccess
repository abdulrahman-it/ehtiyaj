# Verify AllowOverride and mod_alias on the target host.
Options -Indexes
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/\.(?:git|svn|hg)(?:/|$)
</IfModule>
<FilesMatch "(?i)(^\.|\.(?:sql|log|bak|backup|ini|env|dist|swp|old|orig)$|^DEPLOYMENT_CONFIG\.txt$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
